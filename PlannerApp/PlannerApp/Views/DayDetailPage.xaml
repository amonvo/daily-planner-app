<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlannerApp.ViewModels"
             x:Class="PlannerApp.Views.DayDetailPage"
             x:Name="DayDetailRoot"
             x:DataType="vm:DayDetailViewModel"
             Title="Detail dne"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding DateLabel}" Style="{StaticResource H1}" />
                    <Border Style="{StaticResource Badge}" BackgroundColor="{Binding DayTypeBadgeColor}">
                        <Label Text="{Binding DayTypeLabel}" Style="{StaticResource BadgeLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Past day banner -->
            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource SpecialDayBannerBorder}"
                    BackgroundColor="{StaticResource SpecialDayBanner}"
                    Padding="14,10"
                    IsVisible="{Binding IsPastDay}">
                <Label Text="Zpetne doplneni dat pro tento den"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}" />
            </Border>

            <!-- Future day banner -->
            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource AccentRed}"
                    BackgroundColor="{StaticResource SpecialDayBanner}"
                    Padding="14,10"
                    IsVisible="{Binding IsFutureDay}">
                <Label Text="Tento den jeste nenastal - data nelze vyplnovat"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource TextDark}" />
            </Border>

            <!-- Special day banner -->
            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource SpecialDayBannerBorder}"
                    BackgroundColor="{StaticResource SpecialDayBanner}"
                    Padding="14,10"
                    IsVisible="{Binding IsSpecialDay}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding SpecialDayLabel, StringFormat='{0} - tento den se nezapocitava do statistik'}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextDark}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Zrusit"
                            Style="{StaticResource ResetButton}"
                            HeightRequest="32" FontSize="12" Padding="8,0"
                            IsEnabled="{Binding CanEdit}"
                            Command="{Binding ClearSpecialDayCommand}" />
                </Grid>
            </Border>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsSpecialDay, Converter={x:StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pokrok dne" Style="{StaticResource H2}" />
                    <ProgressBar Progress="{Binding ProgressPercent}" HeightRequest="10" />
                    <Label Text="{Binding ProgressLabel}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <!-- Current block (only visible if today) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsToday}">
                <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                    <BoxView Grid.Column="0" Color="{Binding CurrentBlockColor}" WidthRequest="6" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Aktualni aktivita" Style="{StaticResource Muted}" />
                        <Label Text="{Binding CurrentBlockName}" Style="{StaticResource H2}" />
                        <Label Text="{Binding CurrentBlockTime}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding IsToday}">
                <Label Text="{Binding NextBlockInfo}" Style="{StaticResource Body}" />
            </Border>

            <Label Text="Plan dne" Style="{StaticResource H2}" />
            <CollectionView ItemsSource="{Binding Blocks}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlockViewModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" BackgroundColor="{Binding BackgroundColor}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                <BoxView Grid.RowSpan="2" Grid.Column="0" Color="{Binding CategoryColor}" WidthRequest="{Binding LeftBorderWidth}" />

                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                                    <Label Text="{Binding TimeLabel}" FontSize="12" TextColor="{Binding TextColor}" />
                                    <Label Text="{Binding ActivityName}" FontSize="16" FontAttributes="Bold" TextColor="{Binding TextColor}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Grid.Row="0"
                                       Text="&#x2713;"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource AccentGreen}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsCompleted}" />
                                <Label Grid.Column="2" Grid.Row="0"
                                       Text="&#x2014;"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource AccentGray}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsSkipped}" />

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsNotDone}">
                                    <Button Text="Splneno"
                                            Style="{StaticResource DoneButton}"
                                            IsEnabled="{Binding BindingContext.CanEdit, Source={x:Reference DayDetailRoot}}"
                                            Command="{Binding BindingContext.MarkDoneCommand, Source={x:Reference DayDetailRoot}}"
                                            CommandParameter="{Binding}" />
                                    <Button Text="Preskocit"
                                            Style="{StaticResource SkipButton}"
                                            IsEnabled="{Binding BindingContext.CanEdit, Source={x:Reference DayDetailRoot}}"
                                            Command="{Binding BindingContext.MarkSkippedCommand, Source={x:Reference DayDetailRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsCompleted}">
                                    <Button Text="Reset"
                                            Style="{StaticResource ResetButton}"
                                            IsEnabled="{Binding BindingContext.CanEdit, Source={x:Reference DayDetailRoot}}"
                                            Command="{Binding BindingContext.ResetBlockCommand, Source={x:Reference DayDetailRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsSkipped}">
                                    <Button Text="Reset"
                                            Style="{StaticResource ResetButton}"
                                            IsEnabled="{Binding BindingContext.CanEdit, Source={x:Reference DayDetailRoot}}"
                                            Command="{Binding BindingContext.ResetBlockCommand, Source={x:Reference DayDetailRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Poznamky" Style="{StaticResource H2}" />
                    <Editor Text="{Binding Notes, Mode=TwoWay}" AutoSize="TextChanges" HeightRequest="100"
                            IsEnabled="{Binding CanEdit}"
                            Placeholder="Tvoje poznamky k tomuto dni..." />
                </VerticalStackLayout>
            </Border>

            <Button Text="Oznacit jako specialni den"
                    Style="{StaticResource ResetButton}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsSpecialDay, Converter={x:StaticResource InvertedBoolConverter}}"
                    IsEnabled="{Binding CanEdit}"
                    Command="{Binding ToggleSpecialDayCommand}" />
            <Button Text="Zrusit specialni den"
                    Style="{StaticResource ResetButton}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsSpecialDay}"
                    IsEnabled="{Binding CanEdit}"
                    Command="{Binding ClearSpecialDayCommand}" />

            <Label Text="amonvo" FontSize="10" TextColor="{StaticResource WatermarkColor}"
                   HorizontalOptions="End" Opacity="0.6" Margin="0,0,8,4" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
