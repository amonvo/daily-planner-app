<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:PlannerApp.Controls"
             xmlns:vm="clr-namespace:PlannerApp.ViewModels"
             x:Class="PlannerApp.Views.TodayPage"
             x:Name="TodayRoot"
             x:DataType="vm:TodayViewModel"
             Title="Dnes"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" MaximumWidthRequest="920" HorizontalOptions="Fill">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AccentRed}" FontSize="13" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border BackgroundColor="#173B35" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="24">
                <Grid ColumnDefinitions="*,116" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="VÁŠ OSOBNÍ PROSTOR" FontSize="10" CharacterSpacing="2" TextColor="#C4D8B3" />
                        <Label Text="{Binding Greeting}" FontSize="30" FontFamily="OpenSansSemibold" TextColor="White" />
                        <Label Text="{Binding TodayDate}" FontSize="12" TextColor="#D2E2D6" />
                        <Label Text="{Binding ProgressHint}" FontSize="12" TextColor="#D2E2D6" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <charts:ProgressRing Progress="{Binding ProgressPercent}" InputTransparent="True" />
                        <Label Text="DNEŠNÍ POKROK" FontSize="9" CharacterSpacing="1" TextColor="#D2E2D6" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="4"><Label Text="{Binding DoneLabel}" FontSize="22" FontFamily="OpenSansSemibold" /><Label Text="Povinné aktivity" Style="{StaticResource Muted}" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="4"><Label Text="{Binding RemainingLabel}" FontSize="22" FontFamily="OpenSansSemibold" /><Label Text="Vaše dnešní priority" Style="{StaticResource Muted}" /></VerticalStackLayout></Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="PRÁVĚ TEĎ" Style="{StaticResource Muted}" CharacterSpacing="1.5" />
                        <Label Grid.Column="1" Text="{Binding RemainingTime}" Style="{StaticResource Muted}" />
                    </Grid>
                    <Label Text="{Binding CurrentBlockName}" FontSize="25" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding CurrentBlockTime}" Style="{StaticResource Body}" />
                    <Button Text="Označit jako splněné" Command="{Binding CompleteCurrentCommand}" IsVisible="{Binding HasCurrentAction}" HorizontalOptions="Start" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8DF, Dark=#3B5448}" />
                    <Label Text="{Binding NextBlockInfo}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsSpecialDay}">
                <VerticalStackLayout Spacing="8"><Label Text="{Binding SpecialDayLabel}" Style="{StaticResource H2}" /><Label Text="Tento den se nezapočítává do statistik." Style="{StaticResource Body}" /><Button Text="Vrátit běžný plán" Command="{Binding ClearSpecialDayCommand}" Style="{StaticResource ResetButton}" /></VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Váš týden v kostce" Style="{StaticResource H2}" /><Button Grid.Column="1" Text="Detail →" Command="{Binding OpenWeekCommand}" Style="{StaticResource ResetButton}" /></Grid>
                    <Label Text="Posledních 7 dní · splněné povinné aktivity v %" Style="{StaticResource Muted}" />
                    <charts:ProgressChart Points="{Binding RecentTrend}" SelectionCommand="{Binding OpenTrendDayCommand}" />
                    <Label Text="Klepněte na sloupec a otevřete den. Pomlčka znamená den bez záznamu nebo volný den." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ActionMessage}" TextColor="{AppThemeBinding Light=#285C50, Dark=#A6CFB4}" FontSize="12" />
            <Button Text="↶ Vrátit poslední změnu" Command="{Binding UndoLastCommand}" IsVisible="{Binding CanUndo}" Style="{StaticResource ResetButton}" HorizontalOptions="Start" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Text="Celý den" Command="{Binding SetFilterCommand}" CommandParameter="all" BackgroundColor="{Binding AllFilterBackground}" Style="{StaticResource FilterButton}" />
                <Button Grid.Column="1" Text="Zbývající" Command="{Binding SetFilterCommand}" CommandParameter="pending" BackgroundColor="{Binding PendingFilterBackground}" Style="{StaticResource FilterButton}" />
                <Button Grid.Column="2" Text="Priority" Command="{Binding SetFilterCommand}" CommandParameter="focus" BackgroundColor="{Binding FocusFilterBackground}" Style="{StaticResource FilterButton}" />
            </Grid>

            <!-- Blocks list -->
            <Label Text="Váš plán dne" Style="{StaticResource H2}" />
            <CollectionView ItemsSource="{Binding VisibleBlocks}" SelectionMode="None">
                <CollectionView.EmptyView><VerticalStackLayout Padding="20" Spacing="8"><Label Text="Tady máte hotovo." Style="{StaticResource H2}" /><Label Text="Prohlédněte si celý den nebo si dopřejte přestávku." Style="{StaticResource Body}" /></VerticalStackLayout></CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlockViewModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" BackgroundColor="{Binding BackgroundColor}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                <BoxView Grid.RowSpan="2" Grid.Column="0" Color="{Binding CategoryColor}" WidthRequest="{Binding LeftBorderWidth}" />

                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                                    <Label Text="{Binding TimeLabel}" FontSize="12" TextColor="{Binding TextColor}" />
                                    <Label Text="{Binding ActivityName}" FontSize="16" FontAttributes="Bold" TextColor="{Binding TextColor}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Grid.Row="0"
                                       Text="&#x2713;"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource AccentGreen}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsCompleted}" />
                                <Label Grid.Column="2" Grid.Row="0"
                                       Text="&#x2014;"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource AccentGray}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsSkipped}" />

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsNotDone}">
                                    <Button Text="Splněno"
                                            Style="{StaticResource DoneButton}"
                                            Command="{Binding BindingContext.MarkDoneCommand, Source={x:Reference TodayRoot}}"
                                            CommandParameter="{Binding}" />
                                    <Button Text="Přeskočit"
                                            Style="{StaticResource SkipButton}"
                                            Command="{Binding BindingContext.MarkSkippedCommand, Source={x:Reference TodayRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsCompleted}">
                                    <Button Text="Vrátit do plánu"
                                            Style="{StaticResource ResetButton}"
                                            Command="{Binding BindingContext.ResetBlockCommand, Source={x:Reference TodayRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                       Spacing="6" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsSkipped}">
                                    <Button Text="Vrátit do plánu"
                                            Style="{StaticResource ResetButton}"
                                            Command="{Binding BindingContext.ResetBlockCommand, Source={x:Reference TodayRoot}}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Notes -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Poznámky" Style="{StaticResource H2}" />
                    <Editor Text="{Binding Notes, Mode=TwoWay}" AutoSize="TextChanges" HeightRequest="100" Placeholder="Co se dnes povedlo? Co si chcete zapamatovat?" />
                </VerticalStackLayout>
            </Border>

            <!-- Special day toggle -->
            <Button Text="Uvolnit dnešní plán"
                    Style="{StaticResource ResetButton}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsSpecialDay, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding ToggleSpecialDayCommand}" />
            <Button Text="Vrátit běžný plán"
                    Style="{StaticResource ResetButton}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsSpecialDay}"
                    Command="{Binding ClearSpecialDayCommand}" />

            <!-- Watermark -->
            <Label Text="amonvo" FontSize="10" TextColor="{StaticResource WatermarkColor}"
                   HorizontalOptions="End" Opacity="0.6" Margin="0,0,8,4" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
