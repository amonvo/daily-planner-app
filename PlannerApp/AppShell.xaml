<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlannerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PlannerApp.Views"
    Title="PlannerApp"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Dnes" Route="today" ContentTemplate="{DataTemplate views:TodayPage}" />
        <ShellContent Title="Týden" Route="week" ContentTemplate="{DataTemplate views:WeekPage}" />
        <ShellContent Title="Měsíc" Route="month" ContentTemplate="{DataTemplate views:MonthPage}" />
        <ShellContent Title="Rok" Route="year" ContentTemplate="{DataTemplate views:YearPage}" />
    </TabBar>

</Shell>

